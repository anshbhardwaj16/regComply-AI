# Choose ONE provider, set its key, and set LLM_PROVIDER to match.

# Which provider to use: "openai", "groq" or "anthropic"
LLM_PROVIDER=openai

# Option 1: OpenAI (used for the recorded demo) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Any chat model that supports temperature; gpt-4.1 is the tested default.
OPENAI_MODEL=gpt-4.1

# Option 2: Groq (free tier) - https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
